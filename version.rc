/* Windows version information.
 *
 * Without this block the .exe is anonymous: no product name, no version, no
 * author. Anonymous executables score badly with antivirus machine-learning
 * heuristics, which is a common cause of false positives on MinGW builds.
 *
 * Compiled by the Makefile with windres; nothing to do by hand.
 */

#include <winver.h>

#define VER_MAJOR      2
#define VER_MINOR      1
#define VER_PATCH      1
#define VER_STRING     "2.1.1.0"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VER_MAJOR,VER_MINOR,VER_PATCH,0
PRODUCTVERSION  VER_MAJOR,VER_MINOR,VER_PATCH,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Daniele Rufo"
            VALUE "FileDescription",  "Colour GPX tracks by slope"
            VALUE "FileVersion",      VER_STRING
            VALUE "InternalName",     "gpx-slope-colors"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Daniele Rufo. MIT licence."
            VALUE "OriginalFilename", "gpx-slope-colors.exe"
            VALUE "ProductName",      "gpx-slope-colors"
            VALUE "ProductVersion",   VER_STRING
            VALUE "Comments",         "Open source: https://github.com/xdanielex/gpx-slope-colors"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
